---
interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
---

<div class="experience-item">
  <div class="header">
    <div class="timeline-dot">&bull;</div>
    <h3 class="title">{title}</h3>
    <h4 class="company">
      {link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" class="company-link">
          {company}
        </a>
      ) : (
        company
      )}
    </h4>
    <time datetime={date} class="date">{date}</time>
  </div>
  <div class="description">
    {description}
  </div>
</div>

<style>
  .experience-item {
    position: relative;
    padding-bottom: 3rem;
    margin-left: 3rem;
    margin-right: 3rem;
    display: grid;
    gap: 2.5rem;
  }

  /* Vertical line */
  .experience-item::before {
    content: '';
    position: absolute;
    left: -35px;
    display: block;
    height: 100%;
    border-left: 2px solid var(--gray-800);
  }

  .header {
    position: sticky;
    top: 0;
    padding-bottom: 3rem;
  }

  .timeline-dot {
    position: absolute;
    left: -42px;
    font-size: 3rem;
    line-height: 1;
    color: var(--accent-regular);
    text-shadow: 0 0 8px var(--accent-regular);
  }

  .title {
    font-size: var(--text-lg);
    font-weight: bold;
    color: var(--accent-regular);
    margin-bottom: 0.5rem;
  }

  .company {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--gray-200);
  }

  .company-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .company-link:hover {
    color: var(--accent-regular);
    text-decoration: underline;
  }

  .date {
    font-size: var(--text-sm);
    color: var(--gray-400);
  }

  .description {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1rem;
    color: var(--gray-300);
  }

  @media (min-width: 768px) {
    .experience-item {
      grid-template-columns: 2fr 3fr;
    }
    
    .header {
      grid-column: span 2; /* Or adjust based on desired layout */
    }
    
    /* Adjusting to match the original md:grid-cols-5 layout logic if needed */
    .experience-item {
        grid-template-columns: repeat(5, 1fr);
    }
    .header {
        grid-column: span 2;
    }
    .description {
        grid-column: span 3;
    }
  }

  @media (max-width: 768px) {
    .experience-item {
      margin-left: 1.5rem;
      margin-right: 0;
      gap: 1rem;
      padding-bottom: 2rem;
    }
    .experience-item::before {
      left: -20px;
    }
    .timeline-dot {
      left: -26px;
      font-size: 2rem;
    }
    .header {
      padding-bottom: 1rem;
    }
  }
</style>
