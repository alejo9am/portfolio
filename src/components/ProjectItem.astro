---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
	project: CollectionEntry<'work'>;
	align?: 'left' | 'right';
}

const { project, align = 'left' } = Astro.props;
const { data } = project;
---

<article class:list={['project-item', { 'align-right': align === 'right' }]}>
	{data.link ? (
		<a href={data.link} target="_blank" rel="noopener noreferrer" class="image-container">
			<Image src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
		</a>
	) : (
		<div class="image-container">
			<Image src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
		</div>
	)}
	<div class="content-container">
		<h3 class="title">{data.title}</h3>
		<div class="tags">
			{data.tags.map((t) => <span class="tag">{t}</span>)}
		</div>
		<p class="description">{data.description}</p>
		
		<div class="links">
			{data.link && (
				<a href={data.link} target="_blank" rel="noopener noreferrer" class="link-button primary">
					<Icon icon="paper-plane-tilt" size="1.2em" />
					Visitar Web
				</a>
			)}
			{data.repo && (
				<a href={data.repo} target="_blank" rel="noopener noreferrer" class="link-button secondary">
					<Icon icon="github-logo" size="1.2em" />
					Código
				</a>
			)}
		</div>
	</div>
</article>

<style>
	.project-item {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
		padding: 2rem 0;
	}

	.image-container {
		display: block;
		width: 100%;
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		transition: transform var(--theme-transition);
	}

	.image-container:hover {
		transform: scale(1.02);
	}

	.image-container img {
		width: 100%;
		height: auto;
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}

	.content-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		padding: 0.25rem 0.75rem;
		border-radius: 999rem;
		background-color: var(--gray-800);
		color: var(--gray-200);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.description {
		font-size: var(--text-md);
		color: var(--gray-300);
		line-height: 1.6;
	}

	.links {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.link-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border-radius: 999rem;
		text-decoration: none;
		font-weight: 600;
		transition: background-color var(--theme-transition), color var(--theme-transition);
	}

	.link-button.primary {
		background-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.link-button.primary:hover {
		background-color: var(--accent-dark);
	}

	.link-button.secondary {
		background-color: transparent;
		border: 1px solid var(--accent-regular);
		color: var(--accent-regular);
	}

	.link-button.secondary:hover {
		background-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	@media (min-width: 50em) {
		.project-item {
			flex-direction: row;
			gap: 4rem;
		}

		.image-container {
			width: 50%;
		}

		.content-container {
			width: 50%;
		}

		.project-item.align-right {
			flex-direction: row-reverse;
		}
	}
</style>
