---
 
  // lista de posibles tecnologias para el logo wall:
  // "astro",
  // "vue",
  // "react",
  // "typeScript",
  // "tailwindcss",
  // "next",
  // "nodejs",
  // "HTML5",
  // "CSS3",
  // "javaScript",
  // "git",
  // "supabase",
  // "mysql",
  // "bash",

const technologies = [
  { name: "php", icon: "php" },
  { name: "HTML5", icon: "HTML5" },
  { name: "CSS3", icon: "CSS3" },
  { name: "javaScript", icon: "javaScript" },
  { name: "nodejs", icon: "nodejs" },
  { name: "express", icon: "express", iconDark: "expressjs_dark" },
  { name: "git", icon: "git" },
  { name: "mongodb", icon: "mongodb", iconDark: "mongodb-icon-dark" },
  { name: "mysql", icon: "mysql", iconDark: "mysql-icon-dark" },
  { name: "bash", icon: "bash", iconDark: "bash_dark" },
];

---

<div class="logo-wall-container">
  <div class="scroll-track">
    {
      [...technologies, ...technologies, ...technologies].map((tech) => (
        <div class="logo-item">
          {tech.iconDark ? (
            <>
              <img
                class="icon-light"
                src={`/svg/${tech.icon}.svg`}
                alt={tech.name}
                width="30"
                height="30"
                loading="eager"
              />
              <img
                class="icon-dark"
                src={`/svg/${tech.iconDark}.svg`}
                alt={tech.name}
                width="30"
                height="30"
                loading="eager"
              />
            </>
          ) : (
            <img
              src={`/svg/${tech.icon}.svg`}
              alt={tech.name}
              width="30"
              height="30"
              loading="eager"
            />
          )}
          <span>{tech.name.charAt(0).toUpperCase() + tech.name.slice(1)}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .logo-wall-container {
    position: relative;
    overflow: hidden;
    padding: 2rem 0;
    width: 100%;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .scroll-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 3rem;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .scroll-track:hover {
    animation-play-state: paused;
  }

  .logo-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
  }

  .logo-item img {
    height: 1.75rem;
    width: auto;
    object-fit: contain;
    opacity: 0.6;
    transition: transform 0.3s ease;
  }

  .logo-item:hover img {
    transform: scale(1.1);
    opacity: 1;
  }

  .logo-item span {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--gray-300);
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }

  @media (min-width: 768px) {
    .scroll-track {
      gap: 5rem;
      animation-duration: 50s;
    }
  }

  .icon-dark {
    display: none;
  }

  :global(.theme-dark) .icon-light {
    display: none;
  }

  :global(.theme-dark) .icon-dark {
    display: block;
  }
</style>
